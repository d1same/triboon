<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Amazon Appstore prohibits in-app APK self-updating via REQUEST_INSTALL_PACKAGES.
         Fire TV / Fire OS builds receive updates through the Amazon Appstore instead. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <application>
        <!-- Fire OS devices do not ship Google Play Services / Google Cast. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            tools:node="remove" />
    </application>
</manifest>
