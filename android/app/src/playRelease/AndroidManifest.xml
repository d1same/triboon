<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play policy prohibits in-app APK self-updating via REQUEST_INSTALL_PACKAGES.
         Play builds receive updates through Google Play instead of GitHub release APKs. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            tools:node="remove" />
    </application>
</manifest>
