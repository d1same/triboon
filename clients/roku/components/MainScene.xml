<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="launchArgs" type="assocarray" />
    </interface>

    <children>
        <!-- Quiet Graphite root backdrop -->
        <Rectangle id="bg" width="1920" height="1080" color="0x0B0B0FFF" />

        <!-- CONNECT VIEW -->
        <Group id="connectView" visible="false">
            <Rectangle width="920" height="540" translation="[500, 270]" color="0x14141CFF" />
            <Rectangle width="920" height="4" translation="[500, 270]" color="0xE11D74FF" />
            <Label text="Triboon" translation="[560, 320]" font="font:LargeBoldSystemFont" color="0xF5F5F7FF" />
            <Label text="Connect to your self-hosted Triboon server" translation="[560, 386]"
                   font="font:SmallSystemFont" color="0x9DA0AEFF" />
            <Label id="connectServerDisplay" text="No server configured yet" translation="[560, 456]"
                   width="800" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
            <ButtonGroup id="connectButtons" translation="[560, 536]" minWidth="380" maxWidth="800"
                         focusFootprintBitmapUri="" />
            <Label id="connectStatus" text="" translation="[560, 728]" width="800" height="60"
                   wrap="true" font="font:SmallSystemFont" color="0xFB7185FF" />
        </Group>

        <!-- LOGIN / QUICK CONNECT VIEW -->
        <Group id="loginView" visible="false">
            <Rectangle width="980" height="600" translation="[470, 240]" color="0x14141CFF" />
            <Rectangle width="980" height="4" translation="[470, 240]" color="0xE11D74FF" />
            <Label text="Sign in to Triboon" translation="[530, 290]" font="font:LargeBoldSystemFont" color="0xF5F5F7FF" />
            <Label id="loginServerLabel" text="" translation="[530, 352]" width="860"
                   font="font:SmallSystemFont" color="0x9DA0AEFF" />
            <Label text="Quick Connect Code — approve in Triboon on your phone or browser:" translation="[530, 412]"
                   width="860" font="font:SmallSystemFont" color="0xF5F5F7FF" />
            <Label id="qcCodeLabel" text="------" translation="[530, 464]" width="860"
                   font="font:LargeBoldSystemFont" color="0xE11D74FF" />
            <ButtonGroup id="loginButtons" translation="[530, 558]" minWidth="380" maxWidth="860" />
            <Label id="loginStatus" text="" translation="[530, 768]" width="860" height="54"
                   wrap="true" font="font:SmallSystemFont" color="0x9DA0AEFF" />
        </Group>

        <!-- PROFILE PICKER VIEW -->
        <Group id="profileView" visible="false">
            <Rectangle width="760" height="560" translation="[580, 260]" color="0x14141CFF" />
            <Rectangle width="760" height="4" translation="[580, 260]" color="0xE11D74FF" />
            <Label text="Who is watching?" translation="[640, 310]" font="font:LargeBoldSystemFont" color="0xF5F5F7FF" />
            <LabelList id="profileList" translation="[640, 396]" itemSize="[640, 68]" numRows="5"
                       color="0xF5F5F7FF" focusedColor="0xFFFFFFFF" focusBitmapUri="" />
        </Group>

        <!-- BROWSE VIEW -->
        <Group id="browseView" visible="false">
            <Rectangle width="1920" height="96" color="0x111118FF" />
            <Label text="TRIBOON" translation="[64, 28]" font="font:MediumBoldSystemFont" color="0xE11D74FF" />
            <LabelList id="navTabs" translation="[280, 22]" itemSize="[190, 54]" numRows="1"
                       vertFocusAnimationStyle="floatingFocus" color="0x9DA0AEFF" focusedColor="0xFFFFFFFF" />
            <Label id="navHint" text="Press UP for tabs  •  OK to select  •  * for Search" translation="[64, 110]"
                   width="1792" font="font:SmallestSystemFont" color="0x7D8090FF" />
            <Label id="browseStatus" text="" translation="[64, 152]" width="1792"
                   font="font:SmallSystemFont" color="0x9DA0AEFF" />
            <RowList id="browseRows" translation="[64, 198]"
                     itemComponentName="PosterItem"
                     numRows="2"
                     itemSize="[1792, 392]"
                     rowItemSize="[[228, 338]]"
                     rowItemSpacing="[[28, 0]]"
                     showRowLabel="[true]"
                     showRowCounter="[true]"
                     rowLabelOffset="[[0, 14]]"
                     rowFocusAnimationStyle="floatingFocus"
                     vertFocusAnimationStyle="floatingFocus" />
        </Group>

        <!-- DETAIL VIEW -->
        <Group id="detailView" visible="false">
            <Poster id="detailBackdrop" width="1920" height="1080" loadDisplayMode="scaleToFill" />
            <Rectangle width="1920" height="1080" color="0x0B0B0FD9" />
            <Poster id="detailPoster" width="280" height="420" translation="[80, 90]" loadDisplayMode="scaleToFill" />
            <Label id="detailTitle" text="" translation="[400, 96]" width="1420"
                   font="font:LargeBoldSystemFont" color="0xF5F5F7FF" ellipsizeOnBoundary="true" />
            <Label id="detailMeta" text="" translation="[400, 170]" width="1420"
                   font="font:SmallBoldSystemFont" color="0xE11D74FF" />
            <Label id="detailOverview" text="" translation="[400, 224]" width="1400" height="180"
                   wrap="true" font="font:SmallSystemFont" color="0xD4D6E0FF" />
            <ButtonGroup id="detailButtons" translation="[400, 424]" minWidth="300" maxWidth="640" />
            <Label id="detailStatus" text="" translation="[400, 558]" width="1400"
                   font="font:SmallSystemFont" color="0x9DA0AEFF" />
            <RowList id="episodeRows" translation="[80, 610]" visible="false"
                     itemComponentName="PosterItem"
                     numRows="1"
                     itemSize="[1760, 392]"
                     rowItemSize="[[228, 338]]"
                     rowItemSpacing="[[24, 0]]"
                     showRowLabel="[true]"
                     showRowCounter="[true]"
                     rowLabelOffset="[[0, 12]]" />
        </Group>

        <!-- NATIVE VIDEO PLAYER VIEW -->
        <Group id="playerView" visible="false">
            <Video id="videoPlayer" width="1920" height="1080" />
            <Rectangle id="playerOverlay" width="1920" height="120" translation="[0, 0]" color="0x0B0B0FBB" visible="false">
                <Label id="playerTitle" text="" translation="[64, 24]" width="1792"
                       font="font:MediumBoldSystemFont" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
                <Label id="playerStatus" text="" translation="[64, 70]" width="1792"
                       font="font:SmallSystemFont" color="0xD4D6E0FF" />
            </Rectangle>
        </Group>

        <!-- TIMERS -->
        <Timer id="qcPollTimer" repeat="true" duration="2.5" />
        <Timer id="watchSaveTimer" repeat="true" duration="15" />
    </children>

    <script type="text/brightscript" uri="pkg:/source/TriboonUtils.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
