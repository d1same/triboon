<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="launchArgs" type="assocarray" onChange="onDeepLinkArgs" />
        <field id="inputArgs" type="assocarray" onChange="onDeepLinkArgs" />
    </interface>

    <children>
        <!-- Quiet Graphite root backdrop -->
        <Rectangle id="bg" width="1920" height="1080" color="0x0B0B0FFF" />

        <!-- CONNECT VIEW -->
        <Group id="connectView" visible="false">
            <Rectangle width="920" height="540" translation="[500, 270]" color="0x14141CFF" />
            <Rectangle width="920" height="4" translation="[500, 270]" color="0xE11D74FF" />
            <Label text="Triboon" translation="[560, 320]" color="0xF5F5F7FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="46" />
            </Label>
            <Label text="Connect to your self-hosted Triboon server" translation="[560, 386]" color="0x9DA0AEFF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="24" />
            </Label>
            <Label id="connectServerDisplay" text="No server configured yet" translation="[560, 456]"
                   width="800" color="0xFFFFFFFF" ellipsizeOnBoundary="true">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="28" />
            </Label>
            <ButtonGroup id="connectButtons" translation="[560, 536]" minWidth="380" maxWidth="800"
                         focusFootprintBitmapUri="" />
            <Label id="connectStatus" text="" translation="[560, 728]" width="800" height="60"
                   wrap="true" color="0xFB7185FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="22" />
            </Label>
        </Group>

        <!-- LOGIN / QUICK CONNECT VIEW -->
        <Group id="loginView" visible="false">
            <Rectangle width="980" height="600" translation="[470, 240]" color="0x14141CFF" />
            <Rectangle width="980" height="4" translation="[470, 240]" color="0xE11D74FF" />
            <Label text="Sign in to Triboon" translation="[530, 290]" color="0xF5F5F7FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="42" />
            </Label>
            <Label id="loginServerLabel" text="" translation="[530, 352]" width="860" color="0x9DA0AEFF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="22" />
            </Label>
            <Label text="Quick Connect Code — approve in Triboon on your phone or browser:" translation="[530, 412]"
                   width="860" color="0xF5F5F7FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="23" />
            </Label>
            <Label id="qcCodeLabel" text="------" translation="[530, 464]" width="860" color="0xE11D74FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="50" />
            </Label>
            <ButtonGroup id="loginButtons" translation="[530, 558]" minWidth="380" maxWidth="860" />
            <Label id="loginStatus" text="" translation="[530, 768]" width="860" height="54"
                   wrap="true" color="0x9DA0AEFF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="22" />
            </Label>
        </Group>

        <!-- PROFILE PICKER VIEW -->
        <Group id="profileView" visible="false">
            <Rectangle width="760" height="560" translation="[580, 260]" color="0x14141CFF" />
            <Rectangle width="760" height="4" translation="[580, 260]" color="0xE11D74FF" />
            <Label text="Who is watching?" translation="[640, 310]" color="0xF5F5F7FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="40" />
            </Label>
            <LabelList id="profileList" translation="[640, 396]" itemSize="[640, 68]" numRows="5"
                       color="0xF5F5F7FF" focusedColor="0xFFFFFFFF" focusBitmapUri="" />
        </Group>

        <!-- BROWSE VIEW -->
        <Group id="browseView" visible="false">
            <Poster id="browseBackdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
            <Rectangle width="1920" height="1080" color="0x0B0B0FC8" />
            <Rectangle width="1920" height="360" translation="[0, 0]" color="0x0B0B0F88" />
            <Rectangle width="1920" height="88" color="0x0D0D14F2" />
            <Rectangle width="1920" height="2" translation="[0, 88]" color="0xE11D7455" />

            <!-- Brand Logo -->
            <Poster uri="pkg:/images/icon-focus-hd.png" width="136" height="64" translation="[48, 12]" loadDisplayMode="scaleToFit" />

            <!-- Modern Horizontal Top Navigation Bar -->
            <Group id="navBar" translation="[228, 16]" focusable="true">
                <Group id="navTab0" translation="[0, 0]">
                    <Rectangle id="navBg0" width="136" height="54" color="0xFFFFFF00" />
                    <Label id="navLbl0" text="Home" width="136" height="48" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
                        <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="23" />
                    </Label>
                    <Rectangle id="navBar0" width="96" height="4" translation="[20, 50]" color="0xE11D74FF" />
                </Group>
                <Group id="navTab1" translation="[148, 0]">
                    <Rectangle id="navBg1" width="146" height="54" color="0xFFFFFF00" />
                    <Label id="navLbl1" text="Movies" width="146" height="48" horizAlign="center" vertAlign="center" color="0x9DA0AEFF">
                        <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="23" />
                    </Label>
                    <Rectangle id="navBar1" width="106" height="4" translation="[20, 50]" color="0xE11D7400" />
                </Group>
                <Group id="navTab2" translation="[306, 0]">
                    <Rectangle id="navBg2" width="174" height="54" color="0xFFFFFF00" />
                    <Label id="navLbl2" text="TV Shows" width="174" height="48" horizAlign="center" vertAlign="center" color="0x9DA0AEFF">
                        <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="23" />
                    </Label>
                    <Rectangle id="navBar2" width="134" height="4" translation="[20, 50]" color="0xE11D7400" />
                </Group>
                <Group id="navTab3" translation="[492, 0]">
                    <Rectangle id="navBg3" width="166" height="54" color="0xFFFFFF00" />
                    <Label id="navLbl3" text="Libraries" width="166" height="48" horizAlign="center" vertAlign="center" color="0x9DA0AEFF">
                        <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="23" />
                    </Label>
                    <Rectangle id="navBar3" width="126" height="4" translation="[20, 50]" color="0xE11D7400" />
                </Group>
                <Group id="navTab4" translation="[670, 0]">
                    <Rectangle id="navBg4" width="150" height="54" color="0xFFFFFF00" />
                    <Label id="navLbl4" text="Live TV" width="150" height="48" horizAlign="center" vertAlign="center" color="0x9DA0AEFF">
                        <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="23" />
                    </Label>
                    <Rectangle id="navBar4" width="110" height="4" translation="[20, 50]" color="0xE11D7400" />
                </Group>
                <Group id="navTab5" translation="[832, 0]">
                    <Rectangle id="navBg5" width="144" height="54" color="0xFFFFFF00" />
                    <Label id="navLbl5" text="Search" width="144" height="48" horizAlign="center" vertAlign="center" color="0x9DA0AEFF">
                        <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="23" />
                    </Label>
                    <Rectangle id="navBar5" width="104" height="4" translation="[20, 50]" color="0xE11D7400" />
                </Group>
                <Group id="navTab6" translation="[988, 0]">
                    <Rectangle id="navBg6" width="154" height="54" color="0xFFFFFF00" />
                    <Label id="navLbl6" text="Account" width="154" height="48" horizAlign="center" vertAlign="center" color="0x9DA0AEFF">
                        <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="23" />
                    </Label>
                    <Rectangle id="navBar6" width="114" height="4" translation="[20, 50]" color="0xE11D7400" />
                </Group>
            </Group>

            <Label id="navHint" text="* Search   •   UP Menu" translation="[1520, 30]"
                   width="340" horizAlign="right" color="0x9DA0AEFF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="20" />
            </Label>

            <!-- Focused title hero banner -->
            <Label id="browseHeroTitle" text="Triboon" translation="[64, 102]" width="1380"
                   color="0xF5F5F7FF" ellipsizeOnBoundary="true">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="42" />
            </Label>
            <Label id="browseHeroMeta" text="" translation="[64, 160]" width="1380" color="0xE11D74FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="22" />
            </Label>
            <Label id="browseHeroOverview" text="" translation="[64, 194]" width="1280" height="66"
                   wrap="true" maxLines="2" color="0xD4D6E0FF" ellipsizeOnBoundary="true">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="21" />
            </Label>
            <Label id="browseStatus" text="" translation="[64, 266]" width="1792" color="0xFB7185FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="21" />
            </Label>

            <RowList id="browseRows" translation="[64, 304]"
                     itemComponentName="PosterItem"
                     numRows="2"
                     itemSize="[1792, 404]"
                     rowItemSize="[[204, 344]]"
                     rowItemSpacing="[[28, 0]]"
                     showRowLabel="[true]"
                     showRowCounter="[true]"
                     rowLabelOffset="[[0, 10]]"
                     rowFocusAnimationStyle="floatingFocus"
                     vertFocusAnimationStyle="floatingFocus" />
        </Group>

        <!-- DETAIL VIEW -->
        <Group id="detailView" visible="false">
            <Poster id="detailBackdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
            <Rectangle width="1920" height="1080" color="0x0B0B0FDB" />
            <Rectangle width="286" height="426" translation="[77, 83]" color="0x1B1B28FF" />
            <Poster id="detailPoster" width="280" height="420" translation="[80, 86]" loadDisplayMode="scaleToZoom"
                    failedBitmapUri="pkg:/images/icon-focus-hd.png" />
            <Label id="detailTitle" text="" translation="[404, 86]" width="1420"
                   color="0xF5F5F7FF" ellipsizeOnBoundary="true">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="44" />
            </Label>
            <Label id="detailMeta" text="" translation="[404, 152]" width="1420" color="0xE11D74FF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="23" />
            </Label>
            <Label id="detailOverview" text="" translation="[404, 194]" width="1400" height="148"
                   wrap="true" maxLines="4" color="0xD4D6E0FF" ellipsizeOnBoundary="true">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="22" />
            </Label>
            <ButtonGroup id="detailButtons" translation="[404, 358]" minWidth="320" maxWidth="640" />
            <Label id="detailStatus" text="" translation="[404, 554]" width="1420" color="0x9DA0AEFF">
                <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="22" />
            </Label>
            <RowList id="episodeRows" translation="[80, 604]" visible="false"
                     itemComponentName="EpisodeItem"
                     numRows="1"
                     itemSize="[1760, 326]"
                     rowItemSize="[[340, 252]]"
                     rowItemSpacing="[[28, 0]]"
                     showRowLabel="[true]"
                     showRowCounter="[true]"
                     rowLabelOffset="[[0, 12]]"
                     rowFocusAnimationStyle="floatingFocus"
                     vertFocusAnimationStyle="floatingFocus" />
        </Group>

        <!-- NATIVE VIDEO PLAYER VIEW -->
        <Group id="playerView" visible="false">
            <Video id="videoPlayer" width="1920" height="1080" />
            <Rectangle id="playerOverlay" width="1920" height="128" translation="[0, 0]" color="0x0B0B0FCC" visible="false">
                <Label id="playerTitle" text="" translation="[64, 24]" width="1792"
                       color="0xFFFFFFFF" ellipsizeOnBoundary="true">
                    <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="32" />
                </Label>
                <Label id="playerStatus" text="" translation="[64, 74]" width="1792" color="0xD4D6E0FF">
                    <Font role="font" uri="pkg:/fonts/Vazirmatn-Regular.ttf" size="24" />
                </Label>
            </Rectangle>
        </Group>

        <!-- TIMERS & ROKU CHANNEL STORE (RFI) -->
        <Timer id="qcPollTimer" repeat="true" duration="2.5" />
        <Timer id="watchSaveTimer" repeat="true" duration="15" />
        <ChannelStore id="channelStore" />
    </children>

    <script type="text/brightscript" uri="pkg:/source/TriboonUtils.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
