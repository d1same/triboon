<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onItemContentChanged" />
        <field id="focusPercent" type="float" onChange="onFocusChanged" />
    </interface>
    <children>
        <Rectangle id="focusRing" width="348" height="260" translation="[-4, -4]" color="0xE11D7400" />
        <Rectangle id="cardBg" width="340" height="252" color="0x13131BFF" />
        <Rectangle width="340" height="192" color="0x1B1B28FF" />
        <Poster id="still" width="340" height="192" loadDisplayMode="scaleToZoom"
                failedBitmapUri="pkg:/images/icon-focus-hd.png" />
        <Rectangle width="340" height="60" translation="[0, 192]" color="0x111119FF" />
        <Rectangle id="progressTrack" width="340" height="5" translation="[0, 187]" color="0xFFFFFF33" visible="false" />
        <Rectangle id="progressFill" width="0" height="5" translation="[0, 187]" color="0xE11D74FF" visible="false" />
        <Label id="titleLabel" width="316" height="46" translation="[12, 199]"
               wrap="true" maxLines="2" color="0xE5E7F0FF" ellipsizeOnBoundary="true">
            <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="20" />
        </Label>
    </children>
    <script type="text/brightscript" uri="pkg:/components/EpisodeItem.brs" />
</component>
