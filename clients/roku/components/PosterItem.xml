                failedBitmapUri="pkg:/images/icon-focus-hd.png" />
        <Rectangle width="204" height="46" translation="[0, 298]" color="0x111119FF" />
        <Rectangle id="progressTrack" width="204" height="5" translation="[0, 293]" color="0xFFFFFF33" visible="false" />
        <Rectangle id="progressFill" width="0" height="5" translation="[0, 293]" color="0xE11D74FF" visible="false" />
        <Label id="titleLabel" width="186" height="36" translation="[9, 303]"
               color="0xE5E7F0FF" ellipsizeOnBoundary="true">
            <Font role="font" uri="pkg:/fonts/Vazirmatn-Bold.ttf" size="20" />
        </Label>
    </children>
    <script type="text/brightscript" uri="pkg:/components/PosterItem.brs" />
</component>
