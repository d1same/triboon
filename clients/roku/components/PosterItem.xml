    <children>
        <Rectangle id="focusRing" width="212" height="352" translation="[-4, -4]" color="0xE11D7400" />
        <Rectangle id="cardBg" width="204" height="344" color="0x13131BFF" />
        <Rectangle width="204" height="298" color="0x1B1B28FF" />
